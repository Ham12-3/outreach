# ─────────────────────────────────────────────────────────────────────────────
# Outreach Operations Agent — environment variables
# Copy this file to `.env` and fill in the real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB (the partner "superpower") ──────────────────────────────────────
# Your MongoDB Atlas connection string, including the password.
# The MongoDB MCP server reads this exact variable name.
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MDB_MCP_CONNECTION_STRING=

# The database the agent works in. Created on first write if it doesn't exist.
MONGODB_DATABASE=outreach

# The collection that holds leads.
MONGODB_COLLECTION=leads

# ── Gemini 3 brain (via Vertex AI / Gemini Enterprise Agent Platform) ────────
# Use Vertex AI (recommended, matches your Google Cloud setup).
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Your Google Cloud project ID and region.
# Use "global" for Gemini 3 (gemini-3.1-pro-preview is served from the global
# endpoint; regional endpoints like us-central1 will 404 for it).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# The Gemini 3 model. gemini-3.1-pro-preview is the current Gemini 3 model
# (the original gemini-3-pro-preview was retired on 2026-03-26).
GEMINI_MODEL=gemini-3.1-pro-preview

# ── Alternative: AI Studio API key instead of Vertex AI ─────────────────────
# If you prefer an API key over Vertex AI, set GOOGLE_GENAI_USE_VERTEXAI=FALSE
# above and uncomment + fill the line below. (Leave blank when using Vertex.)
# GOOGLE_API_KEY=
